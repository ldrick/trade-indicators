		"eslint-plugin-jsdoc": "^64.3.9",
		"eslint-plugin-package-json": "^1.8.0",
		"eslint-plugin-perfectionist": "^5.11.0",
		"eslint-plugin-unicorn": "^74.0.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"knip": "^6.35.1",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.67.0",
		"rimraf": "^6.1.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-7": "npm:typescript@^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
