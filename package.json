	"files": [
		"dist"
	],
	"scripts": {
		"build": "rimraf dist && tsc --project tsconfig.build.json",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"knip": "knip",
		"lint": "eslint --max-warnings 0 .",
