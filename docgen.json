{
	"$schema": "node_modules/@effect/docgen/schema.json",
	"projectHomepage": "https://github.com/ldrick/trade-indicators",
	"srcDir": "src",
	"outDir": "docs",
	"theme": "pmarsceill/just-the-docs",
	"enableSearch": true,
	"enforceDescriptions": true,
	"enforceExamples": false,
	"enforceVersion": true,
	"runExamples": true,
	"exclude": [
		"src/index.ts",
		"src/steps/*.ts",
		"src/utils/array.ts",
		"src/utils/number.ts",
		"src/utils/record.ts",
		"src/utils/result.ts"
	],
	"examplesCompilerOptions": {
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"paths": {
			"@ldrick/trade-indicators": ["../../src/index.ts"]
		}
	}
}
